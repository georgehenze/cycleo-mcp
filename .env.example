PORT=8787
MCP_AUTH_MODE=local
MCP_HOST=127.0.0.1
MCP_PUBLIC_URL=http://localhost:8787
OAUTH_ISSUER=https://www.cycleo.com
OAUTH_RESOURCE=http://localhost:8787
CYCLEO_API_BASE_URL=https://www.cycleo.com/api/v1
OAUTH_CLIENT_ID=local-test
OAUTH_REDIRECT_URI=http://localhost:8787/callback
CYCLEO_TIMEOUT_MS=10000
OAUTH_TIMEOUT_MS=10000
# Optional hardening / performance knobs (defaults shown)
# CYCLEO_MAX_RESPONSE_BYTES=1048576
# CYCLEO_MAX_RETRIES=2
# AUTH_CACHE_TTL_MS=30000
# RATE_LIMIT_PER_MIN=120
# ACCESS_LOG=on
# ALLOWED_HOSTS defaults to the OAUTH_RESOURCE host; loopback hosts are always allowed
# ALLOWED_HOSTS=mcp.cycleo.com
