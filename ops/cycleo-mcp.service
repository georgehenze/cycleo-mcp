[Unit]
Description=Cycleo MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cycleo-mcp
Group=cycleo-mcp
WorkingDirectory=/var/www/cycleo.mcp/current
EnvironmentFile=/etc/cycleo-mcp/environment
ExecStart=/usr/bin/node /var/www/cycleo.mcp/current/src/server.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
